<?xml version="1.0" encoding="utf-8"?>
<!-- One thumbnail in the Wallpaper pop-up. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="200dp"
    android:layout_height="116dp"
    android:layout_margin="8dp"
    android:padding="3dp"
    android:background="@drawable/wallpaper_thumb_bg"
    android:focusable="true"
    android:clickable="true">

    <ImageView
        android:id="@+id/thumb"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <!-- Label for live/static title -->
    <TextView
        android:id="@+id/label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#99000000"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:singleLine="true"
        android:textColor="#FFFFFFFF"
        android:textSize="12sp"
        android:fontFamily="@font/outfit"
        android:visibility="gone" />

    <TextView
        android:id="@+id/current"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="6dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:background="@drawable/wallpaper_badge_bg"
        android:text="@string/wallpaper_current"
        android:textColor="#FF111111"
        android:textSize="11sp"
        android:fontFamily="@font/outfit"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/checkMark"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="top|start"
        android:layout_margin="6dp"
        android:padding="3dp"
        android:background="@drawable/wallpaper_selected_badge_bg"
        android:src="@drawable/ic_check"
        android:contentDescription="@null"
        android:visibility="gone" />
</FrameLayout>
