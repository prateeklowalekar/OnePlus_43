<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="40dp"
    android:background="@color/bg_dark">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MultiView"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="20dp"
            android:text="Watch YouTube &amp; streams while gaming | 4 View Modes"
            android:textSize="18sp"
            android:textColor="@color/text_secondary" />

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Inactive"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:background="@drawable/btn_bg" />
    </LinearLayout>

    <!-- Section: View Modes -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="1. SELECT VIEW MODE"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/accent"
        android:layout_marginBottom="10dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <!-- PiP Mode Card -->
        <LinearLayout
            android:id="@+id/card_pip"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="16dp"
            android:focusable="true"
            android:clickable="true"
            android:background="@drawable/card_bg"
            android:layout_marginEnd="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PiP (Corner)"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Floating 640x360 corner window. Plays right over games!"
                android:textSize="13sp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <!-- Windowed Mode Card -->
        <LinearLayout
            android:id="@+id/card_windowed"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="16dp"
            android:focusable="true"
            android:clickable="true"
            android:background="@drawable/card_bg"
            android:layout_marginEnd="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Windowed"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Medium 1120x630 centered floating window."
                android:textSize="13sp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <!-- Split Screen Card -->
        <LinearLayout
            android:id="@+id/card_split"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="16dp"
            android:focusable="true"
            android:clickable="true"
            android:background="@drawable/card_bg"
            android:layout_marginEnd="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Split Screen (50/50)"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Side-by-side 960x1080 half screen layout."
                android:textSize="13sp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <!-- Fullscreen Card -->
        <LinearLayout
            android:id="@+id/card_full"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="16dp"
            android:focusable="true"
            android:clickable="true"
            android:background="@drawable/card_bg">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Full Screen"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Full 1080p display for standard video watching."
                android:textSize="13sp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>
    </LinearLayout>

    <!-- Section: Video Source -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="2. STREAM SOURCE"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/accent"
        android:layout_marginBottom="10dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/btn_src_yt_web"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="12dp"
            android:text="YouTube Web (Search &amp; Feed)"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:background="@drawable/btn_bg" />

        <Button
            android:id="@+id/btn_src_yt_tv"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="12dp"
            android:text="YouTube TV Leanback"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:background="@drawable/btn_bg" />

        <Button
            android:id="@+id/btn_src_twitch"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="12dp"
            android:text="Twitch Stream"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:background="@drawable/btn_bg" />

        <Button
            android:id="@+id/btn_src_sign_in"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Sign In (Sync Premium)"
            android:textSize="14sp"
            android:textColor="#38BDF8"
            android:background="@drawable/btn_bg" />
    </LinearLayout>

    <!-- Section: Actions & Launchers -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="3. SIMULTANEOUS GAMING SHORTCUTS"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/accent"
        android:layout_marginBottom="10dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_launch_drastic"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="12dp"
            android:text="Start PiP &amp; Open DraStic"
            android:textSize="15sp"
            android:textColor="@color/text_primary"
            android:background="@drawable/btn_bg" />

        <Button
            android:id="@+id/btn_launch_myboy"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="12dp"
            android:text="Start PiP &amp; Open MyBoy"
            android:textSize="15sp"
            android:textColor="@color/text_primary"
            android:background="@drawable/btn_bg" />

        <Button
            android:id="@+id/btn_stop"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="Close MultiView Overlay"
            android:textSize="15sp"
            android:textColor="#FCA5A5"
            android:background="@drawable/btn_bg" />
    </LinearLayout>

    <!-- Tips -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Controls Tip: In the overlay HUD, click 'Remote' to switch focus between controlling your game and controlling YouTube video navigation. Click 'Corner' to move PiP to any corner."
        android:textSize="13sp"
        android:textColor="@color/text_secondary" />

</LinearLayout>
